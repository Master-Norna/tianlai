{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tianlai.local/schemas/approved-onset-evidence.schema.json",
  "title": "Tianlai Approved Per-Articulation Onset Evidence",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "kind",
    "approved_sha256",
    "automatic_approval",
    "approved_at",
    "anchor",
    "context",
    "instrument",
    "runtime_fingerprint",
    "review_lead",
    "policy",
    "sources",
    "portable_proof",
    "articulations"
  ],
  "properties": {
    "$schema": {
      "const": "https://tianlai.local/schemas/approved-onset-evidence.schema.json"
    },
    "schema_version": { "const": 1 },
    "kind": { "const": "approved_onset_evidence" },
    "approved_sha256": { "$ref": "#/$defs/sha256" },
    "automatic_approval": { "const": false },
    "approved_at": { "type": "string", "format": "date-time" },
    "anchor": { "const": "performance_note_on_output_frame" },
    "context": { "const": "isolated_attack" },
    "instrument": { "$ref": "#/$defs/instrument" },
    "runtime_fingerprint": { "$ref": "#/$defs/runtimeFingerprint" },
    "review_lead": {
      "type": "object",
      "required": ["reviewer_id", "display_name", "attestation"],
      "properties": {
        "reviewer_id": { "$ref": "#/$defs/nonEmptyString" },
        "display_name": { "type": "string" },
        "attestation": { "const": "explicit_manual_approval" }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": [
        "max_spread_ms",
        "unresolved",
        "unsure",
        "variant_coverage",
        "condition_coverage"
      ],
      "properties": {
        "max_spread_ms": { "type": "number", "exclusiveMinimum": 0 },
        "unresolved": { "const": "block" },
        "unsure": { "const": "block" },
        "variant_coverage": { "const": "all_runtime_variants" },
        "condition_coverage": { "const": "sampled_conditions" }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "required": [
        "candidate_path",
        "candidate_sha256",
        "candidate_file_sha256",
        "review_path",
        "review_sha256",
        "review_file_sha256"
      ],
      "properties": {
        "candidate_path": { "$ref": "#/$defs/projectPath" },
        "candidate_sha256": { "$ref": "#/$defs/sha256" },
        "candidate_file_sha256": { "$ref": "#/$defs/sha256" },
        "review_path": { "$ref": "#/$defs/projectPath" },
        "review_sha256": { "$ref": "#/$defs/sha256" },
        "review_file_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "portable_proof": { "$ref": "#/$defs/portableProof" },
    "articulations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/articulation" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*:).+$"
    },
    "nullableSha256": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/sha256" }
      ]
    },
    "nullablePath": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/projectPath" }
      ]
    },
    "boundFile": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/nullablePath" },
        "sha256": { "$ref": "#/$defs/nullableSha256" }
      },
      "additionalProperties": false
    },
    "instrument": {
      "type": "object",
      "required": ["manifest_path", "manifest_sha256"],
      "properties": {
        "manifest_path": { "$ref": "#/$defs/projectPath" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "manifestBinding": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/projectPath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "runtimeFingerprint": {
      "type": "object",
      "required": [
        "algorithm",
        "manifest",
        "render_python_closure",
        "runtime_dependencies",
        "local_implementation",
        "resource_verification",
        "pitch_calibration",
        "runtime_asset_graph"
      ],
      "properties": {
        "algorithm": { "const": "sha256-path-content-v1" },
        "manifest": { "$ref": "#/$defs/manifestBinding" },
        "render_python_closure": {
          "$ref": "#/$defs/renderPythonClosure"
        },
        "runtime_dependencies": {
          "$ref": "#/$defs/runtimeDependencies"
        },
        "local_implementation": { "$ref": "#/$defs/boundFile" },
        "resource_verification": { "$ref": "#/$defs/boundFile" },
        "pitch_calibration": { "$ref": "#/$defs/boundFile" },
        "runtime_asset_graph": { "$ref": "#/$defs/runtimeAssetGraph" }
      },
      "additionalProperties": false
    },
    "renderPythonClosure": {
      "type": "object",
      "required": [
        "algorithm",
        "entry_modules",
        "file_count",
        "files",
        "sha256"
      ],
      "properties": {
        "algorithm": { "const": "ast-render-import-closure-v1" },
        "entry_modules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^tianlai(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"
          }
        },
        "file_count": { "type": "integer", "minimum": 1 },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": {
                "allOf": [
                  { "$ref": "#/$defs/projectPath" },
                  { "pattern": "^tianlai/.+\\.py$" }
                ]
              },
              "sha256": { "$ref": "#/$defs/sha256" }
            },
            "additionalProperties": false
          }
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "runtimeDependencies": {
      "type": "object",
      "required": ["python", "numpy", "soundfile", "pyfluidsynth"],
      "properties": {
        "python": {
          "type": "object",
          "required": [
            "implementation",
            "version",
            "system",
            "machine",
            "byteorder"
          ],
          "properties": {
            "implementation": { "$ref": "#/$defs/nonEmptyString" },
            "version": { "$ref": "#/$defs/nonEmptyString" },
            "system": { "$ref": "#/$defs/nonEmptyString" },
            "machine": { "$ref": "#/$defs/nonEmptyString" },
            "byteorder": { "enum": ["little", "big"] }
          },
          "additionalProperties": false
        },
        "numpy": {
          "type": "object",
          "required": ["version"],
          "properties": {
            "version": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        },
        "soundfile": {
          "type": "object",
          "required": ["version", "libsndfile_version"],
          "properties": {
            "version": { "$ref": "#/$defs/nonEmptyString" },
            "libsndfile_version": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        },
        "pyfluidsynth": {
          "type": "object",
          "required": [
            "applicable",
            "package_version",
            "api_version",
            "native_identifier",
            "native_sha256",
            "native_version"
          ],
          "properties": {
            "applicable": { "type": "boolean" },
            "package_version": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/nonEmptyString" }
              ]
            },
            "api_version": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/nonEmptyString" }
              ]
            },
            "native_identifier": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/nonEmptyString" }
              ]
            },
            "native_sha256": { "$ref": "#/$defs/nullableSha256" },
            "native_version": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/nonEmptyString" }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": { "applicable": { "const": false } },
                "required": ["applicable"]
              },
              "then": {
                "properties": {
                  "package_version": { "type": "null" },
                  "api_version": { "type": "null" },
                  "native_identifier": { "type": "null" },
                  "native_sha256": { "type": "null" },
                  "native_version": { "type": "null" }
                }
              },
              "else": {
                "properties": {
                  "package_version": { "$ref": "#/$defs/nonEmptyString" },
                  "api_version": { "$ref": "#/$defs/nonEmptyString" },
                  "native_identifier": { "$ref": "#/$defs/nonEmptyString" },
                  "native_version": { "$ref": "#/$defs/nonEmptyString" }
                }
              }
            }
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "runtimeAssetGraph": {
      "type": "object",
      "required": [
        "algorithm",
        "sample_rate_hz",
        "file_count",
        "total_bytes",
        "region_count",
        "sha256"
      ],
      "properties": {
        "algorithm": { "const": "constructed-runtime-asset-graph-v1" },
        "sample_rate_hz": { "const": 48000 },
        "file_count": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0 },
        "region_count": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "conditionCoverage": {
      "type": "object",
      "required": [
        "kind",
        "condition_id_algorithm",
        "unique_condition_count",
        "condition_ids"
      ],
      "properties": {
        "kind": { "const": "sampled_conditions" },
        "condition_id_algorithm": {
          "const": "onset-isolated-sampled-condition-v1"
        },
        "unique_condition_count": { "type": "integer", "minimum": 1 },
        "condition_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        }
      },
      "additionalProperties": false
    },
    "sampledCondition": {
      "type": "object",
      "required": [
        "context",
        "final_articulation",
        "midi_note",
        "velocity",
        "sample_rate_hz",
        "tuning",
        "event_contract"
      ],
      "properties": {
        "context": { "const": "isolated_attack" },
        "final_articulation": { "$ref": "#/$defs/nonEmptyString" },
        "midi_note": { "type": "integer", "minimum": 0, "maximum": 127 },
        "velocity": { "type": "integer", "minimum": 1, "maximum": 127 },
        "sample_rate_hz": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 384000
        },
        "tuning": { "const": "equal_temperament_a4_440" },
        "event_contract": {
          "const": "isolated_note_id_1_no_private_sampler_controls"
        }
      },
      "additionalProperties": false
    },
    "topLevelVariantContract": {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "backend",
        "audio_selection_model",
        "capture_completeness",
        "expected_component_sha256s",
        "expected_selection_count",
        "manifest_type",
        "factory_route"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "top_level_runtime_variant_contract" },
        "backend": {
          "enum": [
            "builtin_oscillator",
            "builtin_sample_instrument",
            "builtin_dedicated_sfz"
          ]
        },
        "audio_selection_model": {
          "enum": [
            "code_deterministic_no_runtime_choices",
            "sample_region_selector_v1",
            "dedicated_sfz_attack_layer_bundle_v1",
            "dedicated_sfz_finite_rr_attack_bundle_v1"
          ]
        },
        "capture_completeness": {
          "enum": [
            "no_audio_selection_components",
            "all_audio_selection_delegated_to_runtime_variant_capture",
            "all_note_on_attack_layer_selectors_and_retained_bundle_reconstructed"
          ]
        },
        "expected_component_sha256s": {
          "type": "array",
          "items": { "$ref": "#/$defs/sha256" }
        },
        "expected_selection_count": {
          "type": "integer",
          "minimum": 0
        },
        "manifest_type": {
          "enum": ["oscillator", "sample", "dedicated_sfz"]
        },
        "factory_route": {
          "const": "builtin_manifest_dispatch_no_implementation"
        },
        "attack_phase_contract": { "type": "object" },
        "finite_rr_cycle_contract": { "type": "object" }
      },
      "additionalProperties": false
    },
    "selectionReceipt": {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "claim",
        "selection_count",
        "all_conditions_deterministic_single",
        "catalogs",
        "selections",
        "receipt_sha256"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "runtime_variant_selection_receipt" },
        "claim": { "const": "capture_only_not_variant_certification" },
        "selection_count": { "type": "integer", "minimum": 0 },
        "all_conditions_deterministic_single": { "type": "boolean" },
        "catalogs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["catalog_sha256", "catalog"],
            "properties": {
              "catalog_sha256": { "$ref": "#/$defs/sha256" },
              "catalog": { "type": "object" }
            },
            "additionalProperties": false
          }
        },
        "selections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "selection_index",
              "component_sha256",
              "condition_sha256",
              "choice_sha256",
              "catalog_sha256",
              "deterministic_single",
              "unexhausted_domains",
              "actual_selector",
              "wrapper_outcome"
            ],
            "properties": {
              "selection_index": { "type": "integer", "minimum": 0 },
              "component_sha256": { "$ref": "#/$defs/sha256" },
              "condition_sha256": { "$ref": "#/$defs/sha256" },
              "choice_sha256": { "$ref": "#/$defs/sha256" },
              "catalog_sha256": { "$ref": "#/$defs/sha256" },
              "deterministic_single": { "type": "boolean" },
              "unexhausted_domains": {
                "type": "array",
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/nonEmptyString" }
              },
              "actual_selector": { "type": "object" },
              "wrapper_outcome": {
                "type": ["object", "null"]
              }
            },
            "additionalProperties": false
          }
        },
        "receipt_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "variantProof": {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "certification_protocol",
        "claim",
        "condition_id",
        "sampled_condition",
        "variation_slot",
        "top_level_contract",
        "top_level_contract_sha256",
        "selection_receipt_sha256",
        "catalog_sha256s",
        "component_sha256s",
        "choice_sha256s",
        "proof_sha256"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": {
          "enum": [
            "deterministic_single_runtime_variant_proof",
            "finite_rr_runtime_variant_proof"
          ]
        },
        "certification_protocol": {
          "enum": [
            "tianlai-deterministic-single-v1",
            "tianlai-natural-finite-rr-cycle-v1"
          ]
        },
        "claim": {
          "enum": [
            "all_runtime_variants_at_one_sampled_condition",
            "one_rendered_slot_of_complete_finite_rr_cycle"
          ]
        },
        "condition_id": { "$ref": "#/$defs/sha256" },
        "sampled_condition": { "$ref": "#/$defs/sampledCondition" },
        "variation_slot": { "type": "integer", "minimum": 0 },
        "variation_period": {
          "type": "integer",
          "minimum": 2,
          "maximum": 64
        },
        "slot_bundle_sha256": { "$ref": "#/$defs/sha256" },
        "top_level_contract": {
          "$ref": "#/$defs/topLevelVariantContract"
        },
        "top_level_contract_sha256": { "$ref": "#/$defs/sha256" },
        "selection_receipt_sha256": { "$ref": "#/$defs/sha256" },
        "catalog_sha256s": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "component_sha256s": {
          "type": "array",
          "items": { "$ref": "#/$defs/sha256" }
        },
        "choice_sha256s": {
          "type": "array",
          "items": { "$ref": "#/$defs/sha256" }
        },
        "proof_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "portableProof": {
      "type": "object",
      "required": ["candidate", "review"],
      "properties": {
        "candidate": {
          "type": "object",
          "required": [
            "candidate_sha256",
            "automatic_approval",
            "protocol",
            "observations"
          ],
          "properties": {
            "candidate_sha256": { "$ref": "#/$defs/sha256" },
            "automatic_approval": { "const": false },
            "protocol": {
              "type": "object",
              "required": [
                "anchor",
                "context",
                "variant_coverage",
                "condition_coverage",
                "signal_stage",
                "sample_rate_hz"
              ],
              "properties": {
                "anchor": { "const": "performance_note_on_output_frame" },
                "context": { "const": "isolated_attack" },
                "variant_coverage": { "const": "all_runtime_variants" },
                "condition_coverage": {
                  "$ref": "#/$defs/conditionCoverage"
                },
                "signal_stage": {
                  "const": "instrument_direct_output_no_space"
                },
                "sample_rate_hz": {
                  "type": "integer",
                  "minimum": 8000,
                  "maximum": 384000
                }
              },
              "additionalProperties": false
            },
            "observations": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/portableObservation" }
            }
          },
          "additionalProperties": false
        },
        "review": {
          "type": "object",
          "required": [
            "review_sha256",
            "candidate_sha256",
            "automatic_decision",
            "status",
            "reviewer",
            "decisions"
          ],
          "properties": {
            "review_sha256": { "$ref": "#/$defs/sha256" },
            "candidate_sha256": { "$ref": "#/$defs/sha256" },
            "automatic_decision": { "const": false },
            "status": { "const": "complete" },
            "reviewer": {
              "type": "object",
              "required": ["reviewer_id", "display_name"],
              "properties": {
                "reviewer_id": { "$ref": "#/$defs/nonEmptyString" },
                "display_name": { "type": "string" }
              },
              "additionalProperties": false
            },
            "decisions": {
              "type": "array",
              "items": { "$ref": "#/$defs/portableDecision" }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "portableObservation": {
      "type": "object",
      "required": [
        "observation_id",
        "final_articulation",
        "midi_note",
        "velocity",
        "note_on_frame",
        "condition_id",
        "variation_slot",
        "variant_catalog_proof",
        "selection_receipt",
        "analysis_status",
        "performance_sha256",
        "wav_sha256"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "final_articulation": { "$ref": "#/$defs/nonEmptyString" },
        "midi_note": { "type": "integer", "minimum": 0, "maximum": 127 },
        "velocity": { "type": "integer", "minimum": 1, "maximum": 127 },
        "note_on_frame": { "type": "integer", "minimum": 0 },
        "condition_id": { "$ref": "#/$defs/sha256" },
        "variation_slot": { "type": "integer", "minimum": 0 },
        "variant_catalog_proof": { "$ref": "#/$defs/variantProof" },
        "selection_receipt": { "$ref": "#/$defs/selectionReceipt" },
        "analysis_status": { "enum": ["proposed", "unresolved"] },
        "performance_sha256": { "$ref": "#/$defs/sha256" },
        "wav_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "portableDecision": {
      "type": "object",
      "required": [
        "observation_id",
        "status",
        "measured_onset_frame"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "status": {
          "enum": ["pending", "measured", "exclude", "unsure"]
        },
        "measured_onset_frame": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0 }
          ]
        }
      },
      "additionalProperties": false
    },
    "articulation": {
      "type": "object",
      "required": [
        "final_articulation",
        "frames",
        "sample_rate_hz",
        "observation_count",
        "spread_frames",
        "aggregation",
        "observation_ids"
      ],
      "properties": {
        "final_articulation": { "$ref": "#/$defs/nonEmptyString" },
        "frames": { "type": "integer", "minimum": 0 },
        "sample_rate_hz": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 384000
        },
        "observation_count": { "type": "integer", "minimum": 1 },
        "spread_frames": { "type": "integer", "minimum": 0 },
        "aggregation": { "const": "median_frames_half_up" },
        "observation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
