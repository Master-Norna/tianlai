{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tianlai.local/schemas/authoring-project-storage.schema.json",
  "title": "Tianlai Authoring Project Durable Metadata v1",
  "description": "Exact schemas for tianlai-project.json and immutable revision.json metadata.",
  "oneOf": [
    { "$ref": "#/$defs/projectManifest" },
    { "$ref": "#/$defs/revisionManifest" },
    { "$ref": "#/$defs/saveEvent" }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "canonicalUtcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "projectManifest": {
      "type": "object",
      "required": [
        "kind",
        "schema_version",
        "project_id",
        "title",
        "created_at_utc",
        "updated_at_utc",
        "current_revision"
      ],
      "properties": {
        "kind": { "const": "tianlai.authoring_project" },
        "schema_version": { "const": 1 },
        "project_id": { "$ref": "#/$defs/projectId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "created_at_utc": { "$ref": "#/$defs/canonicalUtcTimestamp" },
        "updated_at_utc": { "$ref": "#/$defs/canonicalUtcTimestamp" },
        "current_revision": { "$ref": "#/$defs/sha256" },
        "save_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "current_save_event_sha256": { "$ref": "#/$defs/sha256" }
      },
      "dependentRequired": {
        "save_sequence": ["current_save_event_sha256"],
        "current_save_event_sha256": ["save_sequence"]
      },
      "additionalProperties": false
    },
    "documentRecord": {
      "type": "object",
      "required": [
        "filename",
        "canonical_sha256",
        "file_sha256",
        "byte_length"
      ],
      "properties": {
        "filename": { "type": "string" },
        "canonical_sha256": { "$ref": "#/$defs/sha256" },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      },
      "additionalProperties": false
    },
    "revisionManifest": {
      "type": "object",
      "required": [
        "kind",
        "schema_version",
        "project_id",
        "revision",
        "created_at_utc",
        "canonicalization",
        "documents"
      ],
      "properties": {
        "kind": { "const": "tianlai.authoring_project_revision" },
        "schema_version": { "const": 1 },
        "project_id": { "$ref": "#/$defs/projectId" },
        "revision": { "$ref": "#/$defs/sha256" },
        "created_at_utc": { "$ref": "#/$defs/canonicalUtcTimestamp" },
        "first_save_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "parent_revision": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "canonicalization": { "const": "tianlai-json-v1" },
        "documents": {
          "type": "object",
          "required": ["score", "authoring_roster", "render_profile"],
          "properties": {
            "score": {
              "allOf": [
                { "$ref": "#/$defs/documentRecord" },
                { "properties": { "filename": { "const": "score.json" } } }
              ]
            },
            "authoring_roster": {
              "allOf": [
                { "$ref": "#/$defs/documentRecord" },
                { "properties": { "filename": { "const": "authoring-roster.json" } } }
              ]
            },
            "render_profile": {
              "allOf": [
                { "$ref": "#/$defs/documentRecord" },
                { "properties": { "filename": { "const": "render-profile.json" } } }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "dependentRequired": {
        "first_save_sequence": ["parent_revision"],
        "parent_revision": ["first_save_sequence"]
      },
      "additionalProperties": false
    },
    "saveEvent": {
      "type": "object",
      "required": [
        "kind",
        "schema_version",
        "project_id",
        "sequence",
        "revision",
        "parent_event_sha256",
        "parent_revision"
      ],
      "properties": {
        "kind": { "const": "tianlai.authoring_save_event" },
        "schema_version": { "const": 1 },
        "project_id": { "$ref": "#/$defs/projectId" },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "revision": { "$ref": "#/$defs/sha256" },
        "parent_event_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "parent_revision": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
