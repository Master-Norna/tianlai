{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tianlai.local/schemas/listening-review-summary.schema.json",
  "title": "Tianlai Listening Review Summary",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "kind",
    "generated_at",
    "batch_count",
    "item_review_scope_count",
    "response_file_count",
    "ignored_nonresponse_json_count",
    "response_states",
    "disposition_counts",
    "expert_reviewer_count",
    "collaboration_review_gate",
    "responses",
    "items"
  ],
  "properties": {
    "$schema": {
      "const": "https://tianlai.local/schemas/listening-review-summary.schema.json"
    },
    "schema_version": { "const": 2 },
    "kind": { "const": "listening_review_summary" },
    "generated_at": { "type": "string", "format": "date-time" },
    "batch_count": { "type": "integer", "minimum": 1 },
    "item_review_scope_count": { "type": "integer", "minimum": 1 },
    "response_file_count": { "type": "integer", "minimum": 0 },
    "ignored_nonresponse_json_count": {
      "type": "integer",
      "minimum": 0
    },
    "response_states": {
      "type": "object",
      "required": ["accepted", "draft", "stale", "invalid"],
      "properties": {
        "accepted": { "type": "integer", "minimum": 0 },
        "draft": { "type": "integer", "minimum": 0 },
        "stale": { "type": "integer", "minimum": 0 },
        "invalid": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "disposition_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "expert_reviewer_count": { "type": "integer", "minimum": 0 },
    "collaboration_review_gate": {
      "type": "object",
      "required": [
        "automatic_status_change",
        "required_layers",
        "instruments_with_all_required_layers_passed",
        "instruments_missing_required_layers",
        "status",
        "reasons",
        "notice"
      ],
      "properties": {
        "automatic_status_change": { "const": false },
        "required_layers": {
          "const": ["context", "expert", "identity", "technical"]
        },
        "instruments_with_all_required_layers_passed": {
          "type": "integer",
          "minimum": 0
        },
        "instruments_missing_required_layers": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": ["blocked", "eligible_for_review_lead_decision"]
        },
        "reasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "notice": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "batch_id",
          "reviewer_id",
          "state",
          "issues"
        ],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "batch_id": { "type": "string" },
          "reviewer_id": { "type": "string" },
          "state": {
            "enum": ["accepted", "draft", "stale", "invalid"]
          },
          "issues": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "batch_id",
          "layer",
          "item_id",
          "instrument_path",
          "wav_sha256",
          "independent_reviewer_count",
          "required_independent_reviewers",
          "disposition",
          "questions"
        ],
        "properties": {
          "batch_id": { "type": "string", "minLength": 1 },
          "layer": {
            "enum": ["technical", "identity", "expert", "context"]
          },
          "item_id": { "type": "string", "minLength": 1 },
          "instrument_path": { "type": "string", "minLength": 1 },
          "wav_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "independent_reviewer_count": {
            "type": "integer",
            "minimum": 0
          },
          "required_independent_reviewers": {
            "type": "integer",
            "minimum": 1
          },
          "disposition": {
            "enum": [
              "pass",
              "reject",
              "conflict",
              "unsure",
              "insufficient",
              "not_applicable"
            ]
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "question_id",
                "counts",
                "disposition",
                "comments"
              ],
              "properties": {
                "question_id": { "type": "string", "minLength": 1 },
                "counts": {
                  "type": "object",
                  "required": [
                    "pass",
                    "reject",
                    "unsure",
                    "not_applicable"
                  ],
                  "properties": {
                    "pass": { "type": "integer", "minimum": 0 },
                    "reject": { "type": "integer", "minimum": 0 },
                    "unsure": { "type": "integer", "minimum": 0 },
                    "not_applicable": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false
                },
                "disposition": {
                  "enum": [
                    "pass",
                    "reject",
                    "conflict",
                    "unsure",
                    "insufficient",
                    "not_applicable"
                  ]
                },
                "comments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["reviewer_id", "status", "comment"],
                    "properties": {
                      "reviewer_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "status": {
                        "enum": [
                          "pass",
                          "reject",
                          "unsure",
                          "not_applicable"
                        ]
                      },
                      "comment": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
