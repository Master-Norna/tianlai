{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tianlai.local/schemas/candidate.schema.json",
  "title": "Tianlai Immutable Render Candidate",
  "description": "把一次实际渲染所用的 score、roster、render profile、演奏计划与渲染回执绑定在同一不可变候选版本中。",
  "type": "object",
  "required": [
    "format",
    "version",
    "candidate_id",
    "work_id",
    "title",
    "created_at_utc",
    "parent_candidate_id",
    "project",
    "render_receipt"
  ],
  "properties": {
    "format": {
      "const": "tianlai.candidate"
    },
    "version": {
      "enum": [1, 2, 3]
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "work_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "parent_candidate_id": {
      "type": ["string", "null"]
    },
    "pipeline": {
      "$ref": "#/$defs/scoreV2Pipeline"
    },
    "project": {
      "oneOf": [
        { "$ref": "#/$defs/legacyProject" },
        { "$ref": "#/$defs/scoreV2Project" }
      ]
    },
    "render_receipt": {
      "oneOf": [
        { "$ref": "#/$defs/legacyReceiptBinding" },
        { "$ref": "#/$defs/scoreV2ReceiptBinding" }
      ]
    },
    "authoring_project": {
      "type": "object",
      "required": ["project_id", "revision", "authoring_roster"],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "revision": {
          "$ref": "#/$defs/sha256"
        },
        "authoring_roster": {
          "type": "object",
          "required": ["path", "canonical_sha256", "file_sha256"],
          "properties": {
            "path": { "const": "authoring-roster.json" },
            "canonical_sha256": { "$ref": "#/$defs/sha256" },
            "file_sha256": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "authoring_workflow": {
      "type": "object",
      "required": [
        "workflow_id",
        "project_id",
        "reservation_revision",
        "iteration_number",
        "operation_id",
        "authoring_revision",
        "candidate_work_id",
        "candidate_id",
        "parent_work_id",
        "parent_candidate_id",
        "parent_manifest_sha256"
      ],
      "properties": {
        "workflow_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "reservation_revision": {
          "$ref": "#/$defs/sha256"
        },
        "iteration_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "authoring_revision": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_work_id": {
          "$ref": "#/$defs/workflowCandidateId"
        },
        "candidate_id": {
          "$ref": "#/$defs/workflowCandidateId"
        },
        "parent_work_id": {
          "oneOf": [
            { "$ref": "#/$defs/workflowCandidateId" },
            { "type": "null" }
          ]
        },
        "parent_candidate_id": {
          "oneOf": [
            { "$ref": "#/$defs/workflowCandidateId" },
            { "type": "null" }
          ]
        },
        "parent_manifest_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "parent_candidate_id": { "type": "null" } },
            "required": ["parent_candidate_id"]
          },
          "then": {
            "properties": {
              "parent_work_id": { "type": "null" },
              "parent_manifest_sha256": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "parent_work_id": { "$ref": "#/$defs/workflowCandidateId" },
              "parent_manifest_sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      ]
    },
    "cache_telemetry": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "const": "缓存遥测.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "version": { "enum": [2, 3] } },
        "required": ["version"]
      },
      "then": {
        "properties": {
          "created_at_utc": {
            "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
          }
        }
      }
    },
    {
      "if": {
        "properties": { "version": { "enum": [1, 2] } },
        "required": ["version"]
      },
      "then": {
        "properties": {
          "pipeline": false,
          "project": { "$ref": "#/$defs/legacyProject" },
          "render_receipt": { "$ref": "#/$defs/legacyReceiptBinding" }
        }
      }
    },
    {
      "if": {
        "properties": { "version": { "const": 3 } },
        "required": ["version"]
      },
      "then": {
        "required": ["pipeline"],
        "properties": {
          "pipeline": { "$ref": "#/$defs/scoreV2Pipeline" },
          "project": { "$ref": "#/$defs/scoreV2Project" },
          "render_receipt": { "$ref": "#/$defs/scoreV2ReceiptBinding" },
          "authoring_project": false,
          "authoring_workflow": false,
          "cache_telemetry": false
        }
      }
    },
    {
      "if": {
        "required": ["authoring_workflow"]
      },
      "then": {
        "required": ["authoring_project"],
        "properties": {
          "version": { "const": 2 }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workflowCandidateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!\\.{1,2}$)(?!.*[ .]$)[^<>:\"/\\\\|?*\\u0000-\\u001F\\u007F]+$"
    },
    "legacyProject": {
      "type": "object",
      "required": ["score", "roster", "render_profile", "performance_plan_sha256"],
      "properties": {
        "score": { "$ref": "#/$defs/jsonBinding" },
        "roster": { "$ref": "#/$defs/jsonBinding" },
        "render_profile": { "$ref": "#/$defs/jsonBinding" },
        "realization": { "$ref": "#/$defs/jsonBinding" },
        "performance_plan_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "legacyReceiptBinding": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "渲染回执.json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "scoreV2Pipeline": {
      "type": "object",
      "required": ["kind", "contract", "score_schema_version", "executor_count"],
      "properties": {
        "kind": { "const": "score_v2" },
        "contract": { "const": "score-v2-candidate-single-oscillator-asset-free-v1" },
        "score_schema_version": { "const": 2 },
        "executor_count": { "const": 1 }
      },
      "additionalProperties": false
    },
    "scoreV2Project": {
      "type": "object",
      "required": ["score", "roster", "execution_profile", "score_v2_plan_sha256", "performance_bundle_sha256"],
      "properties": {
        "score": { "$ref": "#/$defs/fixedScoreV2Binding" },
        "roster": { "$ref": "#/$defs/fixedRosterBinding" },
        "execution_profile": { "$ref": "#/$defs/fixedExecutionProfileBinding" },
        "score_v2_plan_sha256": { "$ref": "#/$defs/sha256" },
        "performance_bundle_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "scoreV2ReceiptBinding": {
      "type": "object",
      "required": ["path", "sha256", "kind", "schema_version"],
      "properties": {
        "path": { "const": "渲染回执.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "kind": { "const": "tianlai.score_v2_render_receipt" },
        "schema_version": { "const": 1 }
      },
      "additionalProperties": false
    },
    "fixedScoreV2Binding": {
      "allOf": [
        { "$ref": "#/$defs/jsonBinding" },
        { "properties": { "path": { "const": "score-v2.json" } } }
      ]
    },
    "fixedRosterBinding": {
      "allOf": [
        { "$ref": "#/$defs/jsonBinding" },
        { "properties": { "path": { "const": "roster.json" } } }
      ]
    },
    "fixedExecutionProfileBinding": {
      "allOf": [
        { "$ref": "#/$defs/jsonBinding" },
        { "properties": { "path": { "const": "execution-profile.json" } } }
      ]
    },
    "jsonBinding": {
      "type": "object",
      "required": ["path", "canonical_sha256", "file_sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
        },
        "canonical_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "file_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  }
}
