{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tianlai.local/schemas/candidate.schema.json",
  "title": "Tianlai Immutable Render Candidate",
  "description": "把一次实际渲染所用的 score、roster、render profile、演奏计划与渲染回执绑定在同一不可变候选版本中。",
  "type": "object",
  "required": [
    "format",
    "version",
    "candidate_id",
    "work_id",
    "title",
    "created_at_utc",
    "parent_candidate_id",
    "project",
    "render_receipt"
  ],
  "properties": {
    "format": {
      "const": "tianlai.candidate"
    },
    "version": {
      "enum": [1, 2]
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "work_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "parent_candidate_id": {
      "type": ["string", "null"]
    },
    "project": {
      "type": "object",
      "required": [
        "score",
        "roster",
        "render_profile",
        "performance_plan_sha256"
      ],
      "properties": {
        "score": {
          "$ref": "#/$defs/jsonBinding"
        },
        "roster": {
          "$ref": "#/$defs/jsonBinding"
        },
        "render_profile": {
          "$ref": "#/$defs/jsonBinding"
        },
        "performance_plan_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "render_receipt": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "const": "渲染回执.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "authoring_project": {
      "type": "object",
      "required": ["project_id", "revision", "authoring_roster"],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "revision": {
          "$ref": "#/$defs/sha256"
        },
        "authoring_roster": {
          "type": "object",
          "required": ["path", "canonical_sha256", "file_sha256"],
          "properties": {
            "path": { "const": "authoring-roster.json" },
            "canonical_sha256": { "$ref": "#/$defs/sha256" },
            "file_sha256": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "authoring_workflow": {
      "type": "object",
      "required": [
        "workflow_id",
        "project_id",
        "reservation_revision",
        "iteration_number",
        "operation_id",
        "authoring_revision",
        "candidate_work_id",
        "candidate_id",
        "parent_work_id",
        "parent_candidate_id",
        "parent_manifest_sha256"
      ],
      "properties": {
        "workflow_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "reservation_revision": {
          "$ref": "#/$defs/sha256"
        },
        "iteration_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "authoring_revision": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_work_id": {
          "$ref": "#/$defs/workflowCandidateId"
        },
        "candidate_id": {
          "$ref": "#/$defs/workflowCandidateId"
        },
        "parent_work_id": {
          "oneOf": [
            { "$ref": "#/$defs/workflowCandidateId" },
            { "type": "null" }
          ]
        },
        "parent_candidate_id": {
          "oneOf": [
            { "$ref": "#/$defs/workflowCandidateId" },
            { "type": "null" }
          ]
        },
        "parent_manifest_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "parent_candidate_id": { "type": "null" } },
            "required": ["parent_candidate_id"]
          },
          "then": {
            "properties": {
              "parent_work_id": { "type": "null" },
              "parent_manifest_sha256": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "parent_work_id": { "$ref": "#/$defs/workflowCandidateId" },
              "parent_manifest_sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      ]
    },
    "cache_telemetry": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "const": "缓存遥测.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "version": { "const": 2 } },
        "required": ["version"]
      },
      "then": {
        "properties": {
          "created_at_utc": {
            "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
          }
        }
      }
    },
    {
      "if": {
        "required": ["authoring_workflow"]
      },
      "then": {
        "required": ["authoring_project"],
        "properties": {
          "version": { "const": 2 }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workflowCandidateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!\\.{1,2}$)(?!.*[ .]$)[^<>:\"/\\\\|?*\\u0000-\\u001F\\u007F]+$"
    },
    "jsonBinding": {
      "type": "object",
      "required": ["path", "canonical_sha256", "file_sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
        },
        "canonical_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "file_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  }
}
